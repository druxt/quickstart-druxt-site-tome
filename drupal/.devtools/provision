#!/usr/bin/env php
<?php

/**
 * @file
 * Provision the site: install a throwaway SQLite database directly from
 * the committed config (adopting its site UUID), import Tome-tracked
 * content and files, generate OAuth keys, and create a Consumer so the
 * Nuxt frontend can authenticate.
 *
 * Unlike quickstart's `provision` (a fresh `site:install standard`, no
 * committed config to import), this repo's config IS the source of
 * truth - `simple_oauth`, `druxt`, and JSON:API read-write are already
 * enabled in `config/`. `drush site-install --existing-config` installs
 * straight from it. A plain `tome:install` does a fresh `site-install`
 * then a *separate* `config:import`, which fails ("Site UUID in source
 * storage does not match the target storage") because the fresh install
 * already generated its own random UUID before the import ever runs -
 * `--existing-config` avoids that by adopting the config's UUID as part
 * of the same install step.
 *
 * The committed config is authored against DDEV's MySQL (`mysql: 0` in
 * `config/core.extension.yml`), and Drupal refuses to uninstall the
 * module providing its own active DB driver - so this patches the
 * enabled module list to also enable `sqlite`, additively (never
 * removing `mysql`) and only in this checkout, never committed. Same
 * pattern `docs/drupal`'s `.devtools/provision` uses.
 */

declare(strict_types=1);

namespace QuickstartTomeDevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

$db_file = resolve_env_value('DB_FILE', '/tmp/quickstart-tome-drupal-site.sqlite')[0];
$oauth_callback = resolve_env_value('OAUTH_CALLBACK', 'http://localhost:3000/callback')[0];

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '         🚀 PROVISION          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

TASK('Enabling the sqlite module in this checkout only (never committed).');
$extension_yml = 'config/core.extension.yml';
$content = (string) file_get_contents($extension_yml);
if (!str_contains($content, "\n  sqlite:")) {
  $anchor = "  mysql: 0\n";
  if (!str_contains($content, $anchor)) {
    FAIL('Could not find the expected anchor ("%s") in %s to patch in the sqlite module. The module list may have changed shape - update this script\'s anchor rather than skipping the patch.', trim($anchor), $extension_yml);
  }
  $content = str_replace($anchor, $anchor . "  sqlite: 0\n", $content);
  file_put_contents($extension_yml, $content);
}
PASS('sqlite module enabled for this checkout.');

TASK('Preparing web/sites/default/settings.php.');
$settings_php = 'web/sites/default/settings.php';
$settings_contents = (string) file_get_contents($settings_php);
$commented_include = "#\n# if (file_exists(\$app_root . '/' . \$site_path . '/settings.local.php')) {\n#   include \$app_root . '/' . \$site_path . '/settings.local.php';\n# }\n";
$active_include = "\nif (file_exists(\$app_root . '/' . \$site_path . '/settings.local.php')) {\n  include \$app_root . '/' . \$site_path . '/settings.local.php';\n}\n";
if (str_contains($settings_contents, $commented_include)) {
  file_put_contents($settings_php, str_replace($commented_include, $active_include, $settings_contents));
}
elseif (!str_contains($settings_contents, $active_include)) {
  FAIL('Could not find the expected settings.local.php include block (commented or active) in %s. The file may have changed shape - update this script\'s anchor rather than skipping the patch.', $settings_php);
}
PASS('settings.php includes settings.local.php.');

TASK('Configuring the SQLite database at %s.', $db_file);
if (file_exists($db_file)) {
  unlink($db_file);
}
// var_export() so a path containing quotes stays valid PHP.
$db_file_php = var_export($db_file, TRUE);
file_put_contents('web/sites/default/settings.local.php', sprintf(
  "<?php\n\n/**\n * @file\n * Provision-only override, written fresh each run by .devtools/provision.\n * Gitignored - never committed.\n */\n\n\$databases['default']['default'] = [\n  'driver' => 'sqlite',\n  'database' => %s,\n];\n",
  $db_file_php
));
PASS('SQLite database configured.');

TASK('Running drush site-install --existing-config.');
drush('site-install --existing-config');
PASS('Site installed from committed config.');

TASK('Importing Tome-tracked content and files.');
drush('tome:import');
PASS('Content and files imported.');

TASK('Generating OAuth keys.');
// simple_oauth.settings public_key/private_key are already committed,
// pointing at ../keys/* (relative to web/, matching the cwd
// `.devtools/start` runs the webserver from - not this script's cwd).
$keys_dir = getcwd() . '/keys';
if (!is_dir($keys_dir) && !mkdir($keys_dir, 0755, TRUE) && !is_dir($keys_dir)) {
  FAIL('Unable to create %s.', $keys_dir);
}
drush('simple-oauth:generate-keys %s', $keys_dir);
PASS('OAuth keys generated at %s.', $keys_dir);

TASK('Creating the Druxt OAuth Consumer.');
$client_id = generate_uuid();
putenv('OAUTH_CLIENT_ID=' . $client_id);
putenv('OAUTH_CALLBACK=' . $oauth_callback);
drush('php-eval %s', <<<'PHP'
// Simple OAuth 6 rejects an authorize request when it cannot resolve a
// scope, and its default provider is "Dynamic (entity)" with no scopes
// shipped - so a fresh site has none and every login fails with
// "Check the `scope` parameter", whether the frontend sends a scope or
// not. Create one and make it the consumer default, which is what
// ScopeRepository::finalizeScopes() falls back to.
$scope_id = "druxt";
if (!\Drupal::entityTypeManager()->getStorage("oauth2_scope")->load($scope_id)) {
  \Drupal\simple_oauth\Entity\Oauth2Scope::create([
    "id" => $scope_id,
    "name" => $scope_id,
    "description" => "Access granted to the Druxt frontend.",
    "grant_types" => [
      "authorization_code" => ["status" => TRUE, "description" => "Authorization code grant."],
      "refresh_token" => ["status" => TRUE, "description" => "Refresh token grant."],
    ],
    "umbrella" => FALSE,
    "granularity_id" => "role",
    "granularity_configuration" => ["role" => "authenticated"],
  ])->save();
}

$client_id = getenv("OAUTH_CLIENT_ID") ?: \Drupal::service("uuid")->generate();
$consumer = \Drupal\consumers\Entity\Consumer::create([
  "owner_id"     => 1,
  // client_id, not just uuid: simple_oauth 6 looks consumers up by this
  // field, and consumers only enforces it through form validation, so a
  // programmatic save leaves it empty and every OAuth request fails with
  // invalid_client. Same value as the uuid so one ID identifies the
  // consumer everywhere.
  "client_id"    => $client_id,
  "uuid"         => $client_id,
  "label"        => "Druxt",
  "description"  => "DruxtJS is a bridge between frameworks, Drupal in the back, Nuxt in the front.\n\nhttps://druxtjs.org",
  "confidential" => FALSE,
  "pkce"         => TRUE,
  // Required by simple_oauth 6 and, like client_id, enforced only in the
  // form - a programmatic save leaves it empty and the token request
  // fails with unsupported_grant_type. refresh_token lets the frontend
  // renew a session without sending the user back through login.
  "grant_types"  => ["authorization_code", "refresh_token"],
  // The default scope for this grant: with it set, a request that sends
  // no scope (or an empty one, as druxt-auth does) resolves to this
  // rather than being rejected.
  "authorization_code_scopes" => [$scope_id],
  // Multi-value on purpose. The browser builds redirect_uri from its own
  // origin, and an IDE forwarding container port 3000 lands on the next
  // free HOST port (3001, 3002, ...) when 3000 is taken - league then
  // rejects the unregistered redirect_uri as, confusingly,
  // invalid_client. Registering the nearby ports keeps login working in
  // forwarded dev sessions.
  "redirect"     => array_values(array_unique(array_merge(
    [getenv("OAUTH_CALLBACK") ?: "http://localhost:3000/callback"],
    array_map(fn ($port) => "http://localhost:{$port}/callback", range(3000, 3009)),
  ))),
]);
// Validate before saving: these fields are required, but only the
// entity form enforces that, so a programmatic save silently produces a
// consumer that cannot authenticate. Two separate bugs shipped that way
// (empty client_id, empty grant_types), each surfacing only as a failed
// login. Fail here instead.
$violations = $consumer->validate();
if ($violations->count() > 0) {
  $messages = [];
  foreach ($violations as $violation) {
    $messages[] = $violation->getPropertyPath() . ": " . strip_tags((string) $violation->getMessage());
  }
  throw new \RuntimeException("Refusing to save an invalid Consumer - " . implode("; ", $messages));
}
$consumer->save();
PHP);
dotenv_write_var('OAUTH_CLIENT_ID', $client_id);
PASS('Consumer created (client ID %s); OAUTH_CLIENT_ID written to ../.env.', $client_id);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   🚀 PROVISION COMPLETE  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Database: ' . $db_file . PHP_EOL;
echo 'Client ID: ' . $client_id . PHP_EOL;
echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  .devtools/start    # Start the webserver' . PHP_EOL;
echo PHP_EOL;

/**
 * Generate a random UUID (v4).
 */
function generate_uuid(): string {
  $data = random_bytes(16);
  $data[6] = chr((ord($data[6]) & 0x0f) | 0x40);
  $data[8] = chr((ord($data[8]) & 0x3f) | 0x80);

  return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
}
